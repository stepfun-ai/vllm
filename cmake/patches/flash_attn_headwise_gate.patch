 using namespace cute;
 
+// Preserve the materialized output and sigmoid rounding before multiplication.
+__forceinline__ __device__ float gate_exp(float x) {
+    float result;
+    asm("{ .reg .f32 scaled; "
+        "mul.rn.f32 scaled, %1, 0f3FB8AA3B; "
+        "ex2.approx.ftz.f32 %0, scaled; }"
+        : "=f"(result) : "f"(x));
+    return result;
+}
+__forceinline__ __device__ float gate_div_rn(float a, float b) {
+    float result;
+    asm("div.rn.f32 %0, %1, %2;" : "=f"(result) : "f"(a), "f"(b));
+    return result;
+}
+__forceinline__ __device__ float gate_mul_rn(float a, float b) {
+    float result;
+    asm("mul.rn.f32 %0, %1, %2;" : "=f"(result) : "f"(a), "f"(b));
+    return result;
+}
+
+template<typename Element, typename Fragment, typename Coordinates, typename Params, typename BInfo>
+__forceinline__ __device__ void apply_headwise_gate(
+    Fragment &values, const Coordinates &coords, const Params &params,
+    const BInfo &binfo, int batch, int head, int first_row, int rows) {
+    if (params.headwise_gate_ptr == nullptr) { return; }
+    auto gate = reinterpret_cast<const Element *>(params.headwise_gate_ptr);
+    const int64_t base = binfo.q_offset(int64_t(0), params.gate_row_stride, batch)
+        + int64_t(first_row) * params.gate_row_stride
+        + int64_t(head) * params.gate_head_stride;
+    #pragma unroll
+    for (int m = 0; m < size<1>(values); ++m) {
+        const int row = get<0>(coords(0, m, 0));
+        if (row < rows) {
+            const float g = float(gate[base + int64_t(row) * params.gate_row_stride]);
+            const float sig = gate_div_rn(1.0f, __fadd_rn(1.0f, gate_exp(-g)));
+            const float rounded_sig = float(Element(sig));
+            #pragma unroll
+            for (int n = 0; n < size<2>(values); ++n) {
+                #pragma unroll
+                for (int i = 0; i < size<0>(values); ++i) {
+                    values(i, m, n) = Element(
+                        gate_mul_rn(float(values(i, m, n)), rounded_sig));
+                }
+            }
+        }
+    }
+}
