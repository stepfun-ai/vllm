+// The varlen gate API excludes SplitKV, append-KV, ALiBi and softcap.
+// Instantiate only its supported kernel flags; retain the ordinary dispatch.
+template<typename Kernel_traits, bool Is_causal, bool Paged>
+void run_headwise_gate_fwd(Flash_fwd_params &params, cudaStream_t stream) {
+    static_assert(Kernel_traits::kHeadDim == 192);
+    static_assert(Kernel_traits::Has_headwise_gate);
+    constexpr size_t smem_size = Kernel_traits::kSmemSize;
+    const int num_m_block = (params.seqlen_q + Kernel_traits::kBlockM - 1) / Kernel_traits::kBlockM;
+    dim3 grid(num_m_block, params.b, params.h);
+    LOCAL_SWITCH((params.window_size_left >= 0 || params.window_size_right >= 0) && !Is_causal, Is_local, [&] {
+        auto kernel = [&] {
+            if constexpr (Paged) {
+                return &flash_fwd_splitkv_kernel<Kernel_traits, Is_causal, Is_local && !Is_causal,
+                    false, false, true, false, false, false>;
+            } else {
+                return &flash_fwd_kernel<Kernel_traits, false, Is_causal, Is_local && !Is_causal,
+                    false, false, true, false, false>;
+            }
+        }();
+        if (smem_size >= 48 * 1024) {
+            FLASHATTENTION_CUDA_CHECK(cudaFuncSetAttribute(
+                kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, smem_size));
+        }
+        kernel<<<grid, Kernel_traits::kNThreads, smem_size, stream>>>(params);
+        FLASHATTENTION_CUDA_KERNEL_LAUNCH_CHECK();
+    });
+}
